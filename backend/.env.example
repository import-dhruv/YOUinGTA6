# YOUinGTA6 backend configuration
# Copy to .env and fill in. ALL values are optional.

# Official X API v2 app-only Bearer token. Never expose to the browser.
# Without it, profile lookups report "unavailable" and demo/quiz modes are used.
X_BEARER_TOKEN=

# Public site URL (CORS + share links)
SITE_URL=http://localhost:3000

# Comma-separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server port
PORT=8000
