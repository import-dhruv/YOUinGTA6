# YOUinGTA6 backend configuration
# Copy to .env and fill in. ALL values are optional.
# NEVER commit real credentials to version control.

# Official X API v2 app-only Bearer token. Never expose to the browser.
X_BEARER_TOKEN=

# Alternative to the bearer token: app consumer key/secret. The backend can
# mint an app-only bearer token from these automatically.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=

# Public site URL (CORS + share links)
SITE_URL=http://localhost:3000

# Comma-separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server port
PORT=8000
